        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payout_methods\" (\"team_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"number\" TEXT NOT NULL, \"bank_name\" TEXT NULL, \"holder_name\" TEXT NULL, PRIMARY KEY (\"team_id\", \"user_id\"));"
        }
      ]
    },
    {
