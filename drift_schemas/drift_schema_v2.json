    {
      "name": "outbox_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"batch_id\" TEXT NOT NULL DEFAULT '', \"operation\" TEXT NOT NULL, \"payload\" TEXT NOT NULL DEFAULT '', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "teams",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"teams\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"admin_id\" TEXT NOT NULL, \"invite_code\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "team_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"team_members\" (\"team_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"joined_at\" INTEGER NOT NULL, \"display_name\" TEXT NOT NULL, \"photo_url\" TEXT NULL, PRIMARY KEY (\"team_id\", \"user_id\"));"
        }
      ]
    },
    {
