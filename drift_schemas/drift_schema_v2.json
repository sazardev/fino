        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"debts\" (\"id\" TEXT NOT NULL, \"order_id\" TEXT NOT NULL, \"team_id\" TEXT NOT NULL, \"creditor_id\" TEXT NOT NULL, \"debtor_id\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"payment_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
