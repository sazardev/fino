      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"orders\" (\"id\" TEXT NOT NULL, \"team_id\" TEXT NOT NULL, \"creditor_id\" TEXT NOT NULL, \"concept\" TEXT NOT NULL, \"note\" TEXT NULL, \"total_cents\" INTEGER NOT NULL, \"spent_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
