      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" TEXT NOT NULL, \"team_id\" TEXT NOT NULL, \"creditor_id\" TEXT NOT NULL, \"debtor_id\" TEXT NOT NULL, \"debt_ids\" TEXT NOT NULL, \"payout_bank_name\" TEXT NULL, \"payout_last4\" TEXT NOT NULL, \"reference\" TEXT NULL, \"reported_at\" INTEGER NOT NULL, \"awaiting_confirmation_reminder_sent\" INTEGER NOT NULL DEFAULT 0 CHECK (\"awaiting_confirmation_reminder_sent\" IN (0, 1)), PRIMARY KEY (\"id\"));"
