{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  },
  "hosting": {
    "site": "fino-sazarcode",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/@(index.html|flutter_service_worker.js|main.dart.js|version.json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/core/firebase/options/firebase_options_prod.dart": {
          "projectId": "fino-168ae",
          "configurations": {
            "android": "1:890454769525:android:e652c24661c6842b511d3c",
            "web": "1:890454769525:web:7df69586d71f781a511d3c"
          }
        },
        "lib/core/firebase/options/firebase_options_qa.dart": {
          "projectId": "fino-qa",
          "configurations": {
            "android": "1:606338504346:android:43bb43b578d21edeeff123",
            "web": "1:606338504346:web:8d6a8139b79b534deff123"
          }
        }
      }
    }
  }
}
