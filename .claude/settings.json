{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push --no-verify*)",
      "Bash(git * --no-verify*)",
      "Bash(LEFTHOOK=0*)",
      "Bash(*LEFTHOOK=0*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --global core.hooksPath*)",
      "Bash(rm * .git/hooks*)",
      "Bash(lefthook uninstall*)",
      "Edit(lefthook.yml)",
      "Write(lefthook.yml)",
      "Edit(.git/hooks/**)",
      "Write(.git/hooks/**)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-hook-bypass.sh"
          }
        ]
      }
    ]
  }
}
